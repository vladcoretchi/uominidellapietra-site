---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

const p = (await getEntry('pagine', 'corsi'))!.data as any;
const corsi = (await getCollection('corsi')).sort((a, b) => a.data.ordine - b.data.ordine);
const withBody = await Promise.all(corsi.map(async (c) => ({ c, Content: (await render(c)).Content, hasBody: Boolean(c.body?.trim()) })));
const ric = withBody.filter((x) => x.c.data.categoria === 'ricreativo');
const tec = withBody.filter((x) => x.c.data.categoria === 'tecnico');
---
<Base title={p.titolo} description={p.intro}>
  <PageHead depth="-10 m" tone="base" tag={p.etichetta} title={p.titolo} intro={p.intro} />
  <section class="paper stack">
    <h2 class="display h-sm" style="color: var(--slate)">{p.titolo_ricreativi}</h2>
    <div class="grid">
      {ric.map(({ c, Content, hasBody }) => (
        <div class="card"><div class="card-body">
          {c.data.etichetta && <span class="chip">{c.data.etichetta}</span>}
          <h3>{c.data.titolo}</h3>
          {hasBody && <div class="muted"><Content /></div>}
          {c.data.prerequisiti && <p class="muted">Prerequisiti: {c.data.prerequisiti}</p>}
          {c.data.durata && <p class="muted">Durata: {c.data.durata}</p>}
          {c.data.prezzo && <p style="font-weight: 600">{c.data.prezzo}</p>}
        </div></div>
      ))}
    </div>
  </section>
  <section id="tecnici" class="depth tone-abyss" style="padding-top: 72px">
    <div class="stack">
      <h2 class="display h-sm">{p.titolo_tecnici}</h2>
      <div class="grid" style="--cols: 2">
        {tec.map(({ c, Content, hasBody }) => (
          <div class="card-glass">
            {c.data.quota && <span class="step-num" style="font-size: 88px">{c.data.quota} m</span>}
            {c.data.etichetta && <span class="chip chip-ember">{c.data.etichetta}</span>}
            <h3>{c.data.titolo}</h3>
            {hasBody && <div class="soft"><Content /></div>}
            {c.data.prerequisiti && <p class="soft">Prerequisiti: {c.data.prerequisiti}</p>}
            {c.data.durata && <p class="soft">{c.data.durata}</p>}
            {c.data.prezzo && <p style="font-weight: 600">{c.data.prezzo}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
