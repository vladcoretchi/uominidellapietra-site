---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import s from '../data/impostazioni.json';
interface Props { title?: string; description?: string; image?: string; type?: string; noindex?: boolean }
const { title, description = `${s.nome}: ${s.sottotitolo}. Corsi, uscite ai laghi di Como e Iseo, subacquea tecnica e sottoghiaccio.`, image, type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${s.nome}` : `${s.nome} | ${s.sottotitolo}`;
const path = Astro.url.pathname;
// Canonical always on www with trailing slash, like the sitemap
const canonical = new URL(path.endsWith('/') ? path : `${path}/`, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/corsi/', label: 'Corsi' },
  { href: '/eventi/', label: 'Eventi' },
  { href: '/chi-siamo/', label: 'Chi siamo' },
  { href: '/leggenda/', label: 'La leggenda' },
  { href: '/contatti/', label: 'Contatti' },
];
// Affiliation logos in the footer bar (light versions for the dark background)
const loghi = [
  { src: '/uploads/loghi/acsi-chiaro.png', alt: 'ACSI, ente di promozione sportiva', href: 'https://www.acsi.it/', w: 160, h: 76 },
  { src: '/uploads/loghi/cmas-chiaro.svg', alt: 'CMAS, Confédération Mondiale des Activités Subaquatiques', href: 'https://www.cmas.org/', w: 196, h: 76 },
  { src: '/uploads/loghi/pta.png', alt: 'PTA, Pure Tek Training', href: 'https://pta-intl.com/', w: 76, h: 76 },
];
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={s.nome} />
  <meta property="og:locale" content="it_IT" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#121011" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script is:inline>
    // Broken images (404) fall back to the pebble placeholder
    addEventListener('error', (e) => {
      const t = e.target;
      if (t instanceof HTMLImageElement && !t.dataset.missing) { t.dataset.missing = '1'; t.src = '/uploads/logo/sasso-placeholder.svg'; t.classList.add('photo-missing'); }
    }, true);
  </script>
</head>
<body>
  <a class="sr-only" href="#contenuto">Vai al contenuto</a>
  <header class="site-header">
    <a class="brand" href="/">
      <Logo />
      <span><span class="brand-name">{s.nome}</span><span class="brand-sub">{s.sottotitolo}</span></span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav id="nav" class="nav" aria-label="Principale">
      {nav.map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
      <a class="btn btn-ember" href="/contatti/">Prova in piscina</a>
    </nav>
  </header>
  <main id="contenuto"><slot /></main>
  <footer class="site-footer">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label={s.nome}><Logo height={120} /></a>
      <div>
        <strong class="brand-name">{s.ragione_sociale}</strong>
        <span class="soft">{s.sede}</span>
        <span class="soft">C.F. {s.codice_fiscale}</span>
      </div>
    </div>
    <div>
      <strong>Associazione</strong>
      <a href="/chi-siamo/">Chi siamo</a>
      <a href="/associazione/">Statuto e safeguarding</a>
      <a href="/siti/">Siti d'immersione</a>
      <a href="/privacy/">Privacy e cookie</a>
    </div>
    <div>
      <strong>Seguici</strong>
      {s.facebook && <a href={s.facebook}>Facebook</a>}
      {s.instagram && <a href={s.instagram}>Instagram</a>}
      {s.email && <a href={`mailto:${s.email}`}>{s.email}</a>}
    </div>
    <div class="footer-bar">
      <span>Affiliata ACSI - Istruttori CMAS-PTA</span>
      <div class="footer-loghi">
        {loghi.map((l) => <a href={l.href} aria-label={l.alt}><img src={l.src} alt={l.alt} width={l.w} height={l.h} loading="lazy" /></a>)}
      </div>
    </div>
  </footer>
  <script>
    // Mobile menu toggle
    const b = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const n = document.getElementById('nav');
    b?.addEventListener('click', () => {
      const open = n!.classList.toggle('open');
      b.setAttribute('aria-expanded', String(open));
    });
  </script>
</body>
</html>
