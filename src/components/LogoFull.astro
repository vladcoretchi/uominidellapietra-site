---
// Full "Sasso e onda" lockup (symbol + UDP wordmark) for dark backgrounds
import Logo from './Logo.astro';
---
<span class="logo-full">
  <Logo size={84} />
  <span class="logo-full-text">
    <span class="logo-full-udp">UDP</span>
    <span class="logo-full-name">Uomini della Pietra</span>
    <span class="logo-full-sub">SCUOLA SUBACQUEA</span>
  </span>
</span>
<style>
  .logo-full { display: inline-flex; align-items: center; gap: 14px; color: #F3F1EC; }
  .logo-full-text { display: flex; flex-direction: column; gap: 4px; font-family: var(--display); }
  .logo-full-udp { font-size: 46px; line-height: .9; font-weight: 900; font-stretch: 125%; }
  .logo-full-name { font-size: 15px; font-weight: 700; line-height: 1.1; }
  .logo-full-sub { font-size: 10px; font-weight: 600; letter-spacing: .3em; color: #E8702A; line-height: 1; }
</style>
