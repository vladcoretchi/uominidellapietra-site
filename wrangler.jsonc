{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "udp",
  "compatibility_date": "2026-09-01",
  // Worker only for old Joomla URLs, everything else is served as static assets
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/index.php*"]
  }
}
