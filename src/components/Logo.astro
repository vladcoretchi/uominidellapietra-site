---
// Historic UDP shield: light version for dark backgrounds, original for light ones
interface Props { height?: number; tone?: 'dark' | 'light'; class?: string }
const { height = 52, tone = 'dark', class: cls } = Astro.props;
const src = tone === 'dark' ? '/uploads/logo/udp-logo-chiaro.svg' : '/uploads/logo/udp-logo.svg';
---
<img src={src} alt="" width={Math.round(height * 591 / 654)} height={height} class={cls} />
