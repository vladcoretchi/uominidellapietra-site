---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

const p = (await getEntry('pagine', 'corsi'))!.data as any;
const corsi = (await getCollection('corsi')).sort((a, b) => a.data.ordine - b.data.ordine);
const all = await Promise.all(corsi.map(async (c) => ({ c, Content: (await render(c)).Content, hasBody: Boolean(c.body?.trim()) })));
const ric = all.filter((x) => x.c.data.categoria === 'ricreativo');
const tec = all.filter((x) => x.c.data.categoria === 'tecnico');
---
<Base title={p.titolo} description={p.intro}>
  <PageHead depth="-10 m" tone="base" tag={p.etichetta} title={p.titolo} intro={p.intro} />
  <section class="paper stack-lg">
    <div class="stack" style="gap: 12px">
      <h2 class="display h-sm" style="color: var(--slate)">{p.titolo_ricreativi}</h2>
      {p.intro_ricreativi && <p class="lead muted">{p.intro_ricreativi}</p>}
    </div>
    <div class="grid" style="--cols: 2">
      {ric.map(({ c, Content, hasBody }) => (
        <article class="card course">
          {c.data.immagine && <img class="course-img" src={c.data.immagine} alt="" loading="lazy" />}
          <div class="card-body">
            <div class="course-top">
              {c.data.etichetta && <span class="chip">{c.data.etichetta}</span>}
              {c.data.quota && <span class="course-depth">fino a {c.data.quota} m</span>}
            </div>
            <h3>{c.data.titolo}</h3>
            {hasBody && <div class="muted course-text"><Content /></div>}
            {c.data.prerequisiti && <p class="muted"><strong>Prerequisiti:</strong> {c.data.prerequisiti}</p>}
            {c.data.durata && <p class="muted"><strong>Durata:</strong> {c.data.durata}</p>}
            {c.data.prezzo && <p style="font-weight: 600">{c.data.prezzo}</p>}
          </div>
        </article>
      ))}
    </div>
  </section>
  <section id="tecnici" class="depth tone-abyss" style="padding-top: 72px">
    <div class="stack-lg">
      <div class="stack" style="gap: 12px">
        <h2 class="display h-sm">{p.titolo_tecnici}</h2>
        {p.intro_tecnici && <p class="lead soft">{p.intro_tecnici}</p>}
      </div>
      <div class="grid">
        {tec.map(({ c, Content, hasBody }) => (
          <article class="card-glass">
            {c.data.quota && <span class="step-num" style="font-size: 88px">{c.data.quota} m</span>}
            {c.data.etichetta && <span class="chip chip-ember">{c.data.etichetta}</span>}
            <h3>{c.data.titolo}</h3>
            {hasBody && <div class="soft course-text"><Content /></div>}
            {c.data.prerequisiti && <p class="soft"><strong>Prerequisiti:</strong> {c.data.prerequisiti}</p>}
            {c.data.durata && <p class="soft"><strong>Il corso:</strong> {c.data.durata}</p>}
            {c.data.prezzo && <p style="font-weight: 600">{c.data.prezzo}</p>}
          </article>
        ))}
      </div>
      {p.nota && <div class="lead soft note" set:html={p.nota} />}
    </div>
  </section>
</Base>
